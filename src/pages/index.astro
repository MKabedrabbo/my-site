---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getCollection } from "astro:content";
import placeholder1 from "../assets/blog-placeholder-1.jpg";
import placeholder2 from "../assets/blog-placeholder-2.jpg";
import placeholder3 from "../assets/blog-placeholder-3.jpg";
import placeholder4 from "../assets/blog-placeholder-4.jpg";
import placeholder5 from "../assets/blog-placeholder-5.jpg";
import {
  SITE_DESCRIPTION,
  SITE_TITLE,
  GITHUB_URL,
  LINKEDIN_URL,
  EMAIL,
} from "../consts";

const placeholders = [
  placeholder1,
  placeholder2,
  placeholder3,
  placeholder4,
  placeholder5,
];

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="intro">
          <h1>Hey! I'm Moneer!</h1>
          <p>
            Currently starting over, learning full-stack development, shipping real
            projects, and getting better one line of code at a time.
          </p>
          <p>
            <a href="/about">More About Me</a>
          </p>
          <p>
            <a href={GITHUB_URL}>GitHub</a> ·
            <a href={LINKEDIN_URL}>LinkedIn</a> ·
            <a href={`mailto:${EMAIL}`}>Email</a>
          </p>
        </div>
        <h2 class="recent-posts-heading">🚀 Recent Posts</h2>
      </section>
      <ul class="post-grid">
        {
          posts.map((post, index) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <Image
                  width={360}
                  height={200}
                  src={post.data.heroImage ?? placeholders[index % placeholders.length]}
                  alt=""
                />
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
    <Footer />
  </body>
</html>

<style>
  .hero {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .intro {
    padding-top: 2rem;
  }
  .recent-posts-heading {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgb(var(--gray));
    margin: 0 0 2rem 0;
  }
  .post-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
    padding: 0;
    margin: 0 0 3rem 0;
  }
  .post-grid li a {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .post-grid img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 0.75rem;
  }
  .post-grid h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1.25em;
  }
  .post-grid p {
    color: rgb(var(--gray));
    margin: 0;
  }
  @media (max-width: 720px) {
    .hero {
      min-height: auto;
      gap: 3rem;
    }
  }
</style>
